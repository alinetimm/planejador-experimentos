rules_version = '2';

// Mídias dos experimentos: attachments/{uid}/{expId}/{arquivo}
//
// A escrita é confinada ao próprio uid — a permissão de "editor do experimento"
// é validada na criação do doc de metadados, nas regras do Firestore. A Cloud
// Function lê o objeto com privilégio de admin, então não precisa de regra aqui.

service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{uid}/{expId}/{arquivo} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   // 2 GB: cobre vídeo de ensaio sem virar porta aberta.
                   && request.resource.size < 2 * 1024 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType == 'application/octet-stream'
                       || request.resource.contentType.matches('text/.*'));

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
